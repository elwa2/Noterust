{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteRust",
  "version": "1.0.0",
  "identifier": "io.noterust.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoteRust",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "languages": ["Arabic", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
