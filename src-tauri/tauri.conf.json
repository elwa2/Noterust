{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteRust",
  "version": "1.0.7",
  "identifier": "io.noterust.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoteRust",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src 'self' http://htmlpreview.localhost htmlpreview://localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "log", "md", "csv"],
        "name": "NoteRust.txt",
        "description": "NoteRust Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "languages": ["Arabic", "English"],
        "installMode": "currentUser",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/elwa2/Noterust/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMzcxQUQzNEY5QTcyNUIKUldSYmNwcFAweG8zbXdUOHZMMVFVdHI0dzZFM2pRbkgwVTFLOGJwWXNoaG9naTIxTEtNaDF4aGoK"
    }
  }
}
